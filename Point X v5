    -- Перетаскивание водяного знака Point X
    local dragging = false
    local dragInput, dragStart, startPos
    local dragDistance = 0

    watermark.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = watermark.Position
            dragDistance = 0

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    watermark.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            dragDistance = delta.Magnitude
            watermark.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Меню Open / Close
    local menuOpen = false
    local isAnimating = false

    local function ToggleMenu()
        if isAnimating then return end
        isAnimating = true
        menuOpen = not menuOpen

        if menuOpen then
            menuFrame.Visible = true
            menuFrame.Size = UDim2.new(0, 480, 0, 320)
            
            local openTween = TweenService:Create(menuFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                GroupTransparency = 0,
                Size = UDim2.new(0, 520, 0, 360)
            })
            openTween:Play()
            openTween.Completed:Wait()
        else
            local closeTween = TweenService:Create(menuFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                GroupTransparency = 1,
                Size = UDim2.new(0, 480, 0, 320)
            })
            closeTween:Play()
            closeTween.Completed:Wait()
            
            if not menuOpen then
                menuFrame.Visible = false
            end
        end
        
        isAnimating = false
    end

    watermark.MouseButton1Click:Connect(function()
        if dragDistance < 8 then
            PlayClickSound()
            ToggleMenu()
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and (input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift) then
            PlayClickSound()
            ToggleMenu()
        end
    end)

    ToggleMenu()
