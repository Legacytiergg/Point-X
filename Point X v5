    local function createSafeZone(obj)
        if obj:IsA("BasePart") and obj.Name == "Wall" then
            local size = obj.Size
            if size.Y < 30 and (size.X < 15 or size.Z < 15) then
                local existing = obj:FindFirstChild("CustomSafeZone")
                if not existing then
                    local safePart = Instance.new("Part")
                    safePart.Size = Vector3.new(size.X + 6, 1, size.Z + 6)
                    safePart.CFrame = obj.CFrame * CFrame.new(0, size.Y/2, 0)
                    safePart.Anchored = true
