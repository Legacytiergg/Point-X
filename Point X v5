    local function CreateJumpCircle(position)
        local circle = Instance.new("Part")
        circle.Name = "JumpCircle"
        circle.Shape = Enum.PartType.Cylinder
        circle.Size = Vector3.new(0.2, 1, 1)
        circle.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
        circle.Anchored = true
        circle.CanCollide = false
        circle.Material = Enum.Material.Neon
        circle.Color = Color3.fromRGB(255, 255, 255) -- Белый цвет
        circle.Transparency = 0.2
        circle.Parent = workspace

        local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tweenScale = TweenService:Create(circle, tweenInfo, {
            Size = Vector3.new(0.05, 8, 8),
            Transparency = 1
        })

        tweenScale:Play()
        tweenScale.Completed:Connect(function()
            circle:Destroy()
        end)
    end

    local function HookJumpCircle(char)
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hum and hrp then
            hum.Jumping:Connect(function()
                if jumpCirclesEnabled then
                    CreateJumpCircle(hrp.Position - Vector3.new(0, 2.5, 0))
                end
            end)
        end
    end

