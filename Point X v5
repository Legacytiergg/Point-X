                    local existing = obj:FindFirstChild("TestCactusPlatform")
                    if not existing then
                        local visualHeight = obj.Size.Y * mesh.Scale.Y
                        local plat = Instance.new("Part")
                        plat.Size = Vector3.new(7, 1, 7)
                        plat.CFrame = obj.CFrame * CFrame.new(0, (visualHeight / 2) + 0.5, 0)
                        plat.Anchored = true
                        plat.CanCollide = true
                        plat.BrickColor = BrickColor.new("Medium stone grey")
                        plat.Transparency = 0.5
                        plat.Material = Enum.Material.SmoothPlastic
